{
  "schema_version": 1,
  "name": "research_v3",
  "description": "Native parent/inspiration sampling, migration, local-embedding novelty and online meta-scratchpad; subscription Codex only. Supply the served local embedding route explicitly. No model downloads or experiment launch are implied by this file.",
  "evolution": {
    "llm_models": ["$codex"],
    "llm_dynamic_selection": "fixed",
    "llm_kwargs": {"temperatures": [0.0], "max_tokens": 16384},
    "patch_types": ["diff", "full", "cross"],
    "patch_type_probs": [0.5, 0.3, 0.2],
    "max_patch_resamples": 1,
    "max_patch_attempts": 1,
    "max_novelty_attempts": 3,
    "embedding_model": "$local_embedding",
    "code_embed_sim_threshold": 0.99,
    "novelty_llm_models": ["$codex"],
    "meta_rec_interval": 5,
    "meta_llm_models": ["$codex"],
    "meta_max_recommendations": 5,
    "sample_single_meta_rec": true,
    "evolve_prompts": false,
    "use_text_feedback": true,
    "enable_wandb_logging": false
  },
  "database": {
    "parent_selection_strategy": "weighted",
    "parent_selection_lambda": 10.0,
    "num_islands": 2,
    "archive_size": 40,
    "num_archive_inspirations": 1,
    "num_top_k_inspirations": 1,
    "migration_interval": 10,
    "migration_rate": 0.1,
    "island_elitism": true,
    "enforce_island_separation": true
  }
}
